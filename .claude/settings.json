{
  "permissions": {
    "additionalDirectories": ["../faultforge-target"],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git branch --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh repo view:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(git push -f:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-target.ts\"",
            "timeout": 15,
            "statusMessage": "Checking for hints aimed at the target repo"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/factory-policy.ts\"",
            "timeout": 15,
            "statusMessage": "Checking the unattended-run policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate-note.ts\"",
            "timeout": 15,
            "statusMessage": "Checking that a local review saw this commit"
          }
        ]
      }
    ]
  }
}
