{
  "$schema": "./schemas/factory.v1.json",
  "evidence": "private/raw-artifacts",
  "gate": {
    "fix": ["action_required", "remediation_recommended"],
    "flag": ["informational"],
    "maxRounds": 3
  },
  "network": {
    "allow": [
      "api.anthropic.com",
      "api.github.com",
      "github.com",
      "codeload.github.com",
      "objects.githubusercontent.com",
      "registry.npmjs.org"
    ]
  },
  "repos": {
    "faultforge": {
      "github": "AJBeumer/faultforge",
      "path": ".",
      "guard": "lab",
      "check": "npm run check",
      "tests": "(\\.test\\.ts$|/fixtures/|^packages/[^/]+/test/)",
      "checkFiles": {
        "files": "((^|/)(biome\\.jsonc?|\\.npmrc|\\.gitignore|tsconfig[^/]*\\.json|(vite|vitest)[^/]*\\.config\\.[cm]?[jt]s|vitest\\.workspace\\.[cm]?[jt]s)$|^\\.github/workflows/check\\.yml$|^\\.claude/hooks/.*\\.ts$|^factory\\.json$|^schemas/factory\\.v1\\.json$|^packages/harness/src/(repo/vitest-run|docs/docs-check|docs/docs-check-structure|cli/docs-check-cli|shared/(drive-spelling|cli-entry|factory-config|github|jsonl|paths|templates)|ledger/ledger|review/ci-wait|cli/ci-wait-cli)\\.ts$)",
        "scripts": "(^|/)package\\.json$"
      },
      "ciJobs": [
        "npm run check",
        "npm run check (windows)",
        "npm run test:integration (ubuntu-latest)",
        "npm run test:integration (windows-latest)"
      ],
      "start": null,
      "tickets": {
        "sections": ["Result", "Done when", "Must not break"],
        "checklist": "Done when"
      },
      "board": true
    },
    "target": {
      "github": "AJBeumer/faultforge-target",
      "path": "../faultforge-target",
      "guard": "reviewed",
      "check": "npm run check",
      "tests": "(^test/|\\.test\\.ts$)",
      "checkFiles": {
        "files": "((^|/)(biome\\.jsonc?|\\.npmrc|\\.gitignore|tsconfig[^/]*\\.json|(vite|vitest)[^/]*\\.config\\.[cm]?[jt]s|vitest\\.workspace\\.[cm]?[jt]s)$|^\\.github/workflows/check\\.yml$)",
        "scripts": "(^|/)package\\.json$"
      },
      "start": {
        "command": "npx tsx src/server.ts",
        "port": 3000,
        "health": "/health"
      },
      "tickets": {
        "sections": ["What", "Acceptance criteria", "Must not break"],
        "checklist": "Acceptance criteria"
      },
      "board": false
    }
  }
}
