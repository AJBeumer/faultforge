{
  "name": "faultforge",
  "version": "1.0.0",
  "description": "Adversarial quality lab for AI software factories",
  "scripts": {
    "inject": "tsx packages/harness/src/inject.ts",
    "match": "tsx packages/harness/src/match.ts",
    "ticket:ready": "tsx packages/harness/src/ticket-ready.ts",
    "review:wait": "tsx packages/harness/src/review-wait.ts",
    "review:local": "tsx packages/harness/src/review-local.ts",
    "review:gate": "tsx packages/harness/src/review-gate.ts",
    "factory:tick": "tsx packages/harness/src/factory-tick.ts",
    "factory:timeline": "tsx packages/harness/src/factory-timeline.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx packages/harness/src/vitest-run.ts run --project unit",
    "test:integration": "tsx packages/harness/src/vitest-run.ts run --project integration",
    "check": "npm run typecheck && npm run lint && npm test && npm run -s docs:check",
    "docs:check": "tsx packages/harness/src/docs-check.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "rules:evidence": "tsx packages/harness/src/rules-evidence.ts",
    "rules:propose": "tsx packages/harness/src/rules-propose.ts",
    "revert:check": "tsx packages/harness/src/revert-check.ts",
    "ledger:check": "tsx packages/harness/src/ledger-check.ts",
    "qodo:check": "tsx packages/harness/src/qodo-check.ts",
    "verdict": "tsx packages/harness/src/verdict.ts",
    "verdict:amend": "tsx packages/harness/src/verdict-amend.ts",
    "case:build": "tsx packages/harness/src/case-build.ts",
    "case:ticket": "tsx packages/harness/src/case-ticket.ts",
    "case:pr": "tsx packages/harness/src/case-pr.ts",
    "case:review": "tsx packages/harness/src/case-review.ts",
    "guard:install": "tsx packages/harness/src/guard-install.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJBeumer/FaultForge.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/AJBeumer/FaultForge/issues"
  },
  "homepage": "https://github.com/AJBeumer/FaultForge#readme",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
