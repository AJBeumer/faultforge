{
  "name": "faultforge",
  "version": "1.0.0",
  "description": "Adversarial quality lab for AI software factories",
  "scripts": {
    "inject": "tsx packages/harness/src/cli/inject.ts",
    "match": "tsx packages/harness/src/cli/match-cli.ts",
    "ticket:ready": "tsx packages/harness/src/cli/ticket-ready-cli.ts",
    "review:wait": "tsx packages/harness/src/cli/review-wait.ts",
    "ci:wait": "tsx packages/harness/src/cli/ci-wait-cli.ts",
    "review:local": "tsx packages/harness/src/review/review-local.ts",
    "review:gate": "tsx packages/harness/src/review/review-gate.ts",
    "approval:check": "tsx packages/harness/src/cli/approval-check-cli.ts",
    "approval:replay": "tsx packages/harness/src/cli/approval-replay-cli.ts",
    "gate:check": "tsx packages/harness/src/cli/gate-check-cli.ts",
    "gate:replay": "tsx packages/harness/src/cli/gate-replay-cli.ts",
    "gate:trial": "tsx packages/harness/src/cli/gate-trial-cli.ts",
    "clarify:measure": "tsx packages/harness/src/cli/clarify-measure-cli.ts",
    "factory:tick": "tsx packages/harness/src/cli/factory-tick-cli.ts",
    "factory:timeline": "tsx packages/harness/src/cli/factory-timeline-cli.ts",
    "factory:diagram": "tsx packages/harness/src/cli/factory-diagram-cli.ts",
    "reviewer:score": "tsx packages/harness/src/cli/reviewer-score-cli.ts",
    "factory:keep": "tsx packages/harness/src/factory/factory-keep.ts",
    "factory:recover": "tsx packages/harness/src/cli/factory-recover-cli.ts",
    "factory:sandbox": "tsx packages/harness/src/factory/factory-sandbox-setup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx packages/harness/src/repo/vitest-run.ts run --project unit",
    "test:integration": "tsx packages/harness/src/repo/vitest-run.ts run --project integration",
    "check": "npm run typecheck && npm run lint && npm test && npm run -s docs:check",
    "docs:check": "tsx packages/harness/src/cli/docs-check-cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "rules:evidence": "tsx packages/harness/src/rules/rules-evidence.ts",
    "rules:propose": "tsx packages/harness/src/rules/rules-propose.ts",
    "revert:check": "tsx packages/harness/src/factory/revert-check.ts",
    "ledger:anchor": "tsx packages/harness/src/cli/ledger-anchor-cli.ts",
    "ledger:check": "tsx packages/harness/src/cli/ledger-check-cli.ts",
    "ledger:revision": "tsx packages/harness/src/cli/ledger-revise-cli.ts",
    "qodo:check": "tsx packages/harness/src/qodo/qodo-check.ts",
    "verdict": "tsx packages/harness/src/cli/verdict-cli.ts",
    "verdict:amend": "tsx packages/harness/src/cli/verdict-amend-cli.ts",
    "case:build": "tsx packages/harness/src/cli/case-build-cli.ts",
    "case:ticket": "tsx packages/harness/src/cli/case-ticket-cli.ts",
    "case:pr": "tsx packages/harness/src/cli/case-pr-cli.ts",
    "case:review": "tsx packages/harness/src/cli/case-review-cli.ts",
    "target:post": "node packages/harness/src/door/target-post-cli.ts",
    "case:rerun": "tsx packages/harness/src/cli/case-rerun-cli.ts",
    "guard:install": "tsx packages/harness/src/cli/guard-install-cli.ts",
    "proof:verify": "tsx packages/harness/src/cli/proof-verify-cli.ts",
    "skill:exam": "tsx packages/harness/src/cli/skill-exam-cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJBeumer/FaultForge.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/AJBeumer/FaultForge/issues"
  },
  "homepage": "https://github.com/AJBeumer/FaultForge#readme",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
